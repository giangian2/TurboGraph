graph G {
  rankdir=LR;
  node [shape=circle, style=filled, fillcolor=white];

  0 [label="0\nd=0", fillcolor=orange];
  1 [label="1\nd=1", fillcolor=lightblue];
  2 [label="2\nd=1", fillcolor=lightblue];
  3 [label="3\nd=2", fillcolor=lightblue];
  4 [label="4\nd=2", fillcolor=lightblue];
  5 [label="5\nd=3", fillcolor=lightblue];
  6 [label="6\nd=4", fillcolor=lightblue];
  7 [label="7\nd=5", fillcolor=lightblue];
  8;

  0 -- 2 [label="2", color=red, penwidth=2.0];
  0 -- 1 [label="1", color=red, penwidth=2.0];
  1 -- 3 [label="1.5", color=gray50];
  2 -- 4 [label="3", color=red, penwidth=2.0];
  2 -- 3 [label="1", color=red, penwidth=2.0];
  3 -- 5 [label="2", color=gray50];
  4 -- 5 [label="1", color=red, penwidth=2.0];
  5 -- 6 [label="1", color=red, penwidth=2.0];
  6 -- 7 [label="4", color=red, penwidth=2.0];
}
