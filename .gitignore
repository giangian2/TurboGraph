# --- build output -------------------------------------------------------
/bin/
/build/
*.o
*.a
*.so
*.d

# --- debugging / profiling ----------------------------------------------
*.dSYM/
core
vgcore.*
callgrind.out.*
perf.data*

# --- generated graph exports --------------------------------------------
# res/ holds the inputs read by graph_import_dot() and they stay tracked
# (twitch.dot, europe_roads.dot). out/ holds everything written by
# graph_export_dot() or by `dot -T...`: regenerable, never committed.
/out/

# --- editors / OS -------------------------------------------------------
.vscode/
.idea/
*.swp
*~
.DS_Store
